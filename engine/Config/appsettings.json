{
  "AppName": "Server Documentation Tool",
  "Version": "1.0.1",
  "DefaultOutputRoot": "C:\\ServerDocumentation",
  "DefaultParallelLimit": 1,
  "DefaultDocTitle": "Server As-Built Documentation",
  "IncludeRawJson": true,
  "IncludeHtmlSummary": true,
  "IncludeDocx": true,
  "IncludeApplications": true,
  "IncludeCertificates": true,
  "IncludeWorkstations": false,
  "TimeoutSeconds": 30,
  "CimOperationTimeoutSec": 180,
  "SectionTimeoutSec": 300,
  "ServerOperatingSystemFilter": "Windows Server",
  "ReachabilityPingCount": 1,
  "DocumentTemplate": "Templates\\IABB.DefaultTemplate.json",
  "EnableDcomFallback": true,
  "SkipEmptyReports": false,
  "GroupMemberDisplayCap": 15,
  "ApplicationDisplayCap": 200,
  "CertificateExpiringDays": 60,
  "ParallelServers": 4,
  "ServerTimeLimitMinutes": 30,
  "UpdateRepository": "CPSDomain/ServerDocumentationTool",
  "CheckForUpdatesOnStart": true
}
