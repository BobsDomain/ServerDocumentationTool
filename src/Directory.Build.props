<Project>
  <!-- Shared settings for the app and the updater. CI passes -p:Version=<VERSION.txt>; the value below is the default for local builds. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Company>bobsdomain</Company>
    <Product>Server Documentation Tool</Product>
    <Copyright>bobsdomain</Copyright>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets the GitHub Windows runner (and any PC) build net48 without a separately installed targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
